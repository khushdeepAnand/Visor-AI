{
  "name": "stockpilot-ai-terminal",
  "version": "18.0.0-rc.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/generate-api-client.mjs --check",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "generate:api": "node scripts/generate-api-client.mjs",
    "check:api": "node scripts/generate-api-client.mjs --check",
    "check:forecast-honesty": "node --test scripts/check-forecast-honesty.checks.mjs && node scripts/check-forecast-honesty.mjs",
    "audit": "npm audit --audit-level=high",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "verify": "npm run check:api && npm run check:forecast-honesty && npm run test && npm run typecheck && npm run build && npm run audit:prod"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-table": "^8.20.5",
    "@tanstack/react-virtual": "^3.10.8",
    "clsx": "^2.1.1",
    "lightweight-charts": "^5.0.0",
    "lucide-react": "^0.468.0",
    "motion": "^14.0.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-mosaic-component": "^7.0.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest-axe": "3.5.9",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.6.1",
    "jest-axe": "11.0.0",
    "jsdom": "28.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "4.3.3",
    "typescript": "^5.7.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
