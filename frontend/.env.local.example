# Copy to frontend/.env.local. Leave both values empty for local development.
# Empty NEXT_PUBLIC_API_BASE keeps REST calls same-origin, so the session
# cookie is sent and no CORS exception is needed.
NEXT_PUBLIC_API_BASE=
# Empty NEXT_PUBLIC_WS_BASE derives the websocket host from the page origin,
# so a LAN or tunnel host does not silently fall back to localhost.
NEXT_PUBLIC_WS_BASE=
