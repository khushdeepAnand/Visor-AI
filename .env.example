# ==========================================================
# StockPilot AI v6 — backend
# ==========================================================
# Set development only on a local workstation. Release/production and
# OFFLINE_DEMO always require an explicit JWT secret.
STOCKPILOT_ENV=development
# Windows setup stores these in the current-user DPAPI store and leaves this
# plaintext fallback empty. Non-Windows deployments may provide them through a
# deployment secret manager or environment. Each requires at least 32 bytes.
STOCKPILOT_JWT_SECRET=
STOCKPILOT_MFA_SECRET=

# Optional neural sequence challengers. Install requirements-optional.txt and
# list any of lstm,gru,tcn to enable; each still has to pass promotion gates.
STOCKPILOT_SEQUENCE_MODELS=off
STOCKPILOT_SEQUENCE_EPOCHS=6
STOCKPILOT_SESSION_HOURS=12
STOCKPILOT_COOKIE_SECURE=false
# The Windows launcher uses this single canonical loopback hostname.
STOCKPILOT_CORS_ORIGINS=http://127.0.0.1:3000
# Up to three normalized emails. Accounts must register normally before bootstrap.
STOCKPILOT_ADMIN_EMAILS=

# Provider truth mode: LIVE_ONLY, OFFLINE_DEMO, or FALLBACK_ALLOWED.
# Demo data is served only when OFFLINE_DEMO is explicitly selected - it is
# never substituted silently. This starter file ships with OFFLINE_DEMO so a
# fresh checkout with no broker credentials is runnable immediately; every
# quote, chart and forecast will be clearly labeled "demo" in the UI
# (DataSourceBadge) rather than pretending to be live. Once you have added
# and tested a real Upstox credential below, change this to
# LIVE_ONLY to require live data and stop serving demo data entirely - the
# code's own fallback default (when this variable is absent) is already
# LIVE_ONLY (fail-closed), so removing this line has the same effect.
STOCKPILOT_PROVIDER_MODE=OFFLINE_DEMO
# Recommended once you have at least one live credential: FALLBACK_ALLOWED.
# It walks every configured provider in order, then falls back to the free
# no-key yfinance backup (if listed), so "one API down" never blocks data.
# Available providers: truedata, globaldatafeeds, upstox, yfinance, nse, demo.
# Unconfigured licensed providers are skipped. Put a licensed feed first when
# its normalized gateway is configured and covered by your vendor agreement.
# Default order: 1. upstox, 2. yfinance, 3. nse, 4. demo
# Example: STOCKPILOT_PROVIDER_ORDER=upstox,yfinance,nse,demo
STOCKPILOT_PROVIDER_ORDER=upstox,yfinance,nse,demo
STOCKPILOT_QUOTE_CACHE_SECONDS=3
STOCKPILOT_HISTORY_CACHE_SECONDS=60
STOCKPILOT_REFRESH_INSTRUMENTS_ON_START=false

# Upstox market data. For this read-only research terminal, the long-lived
# Analytics Token is preferred for quotes/history/options/WebSocket data.
# Keep the daily OAuth access token for endpoints that specifically require it.
UPSTOX_ACCESS_TOKEN=
UPSTOX_ANALYTICS_TOKEN=
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://127.0.0.1:3000/auth/upstox/callback

# Native broker WebSocket streaming. Set to "none" to force REST polling.
STOCKPILOT_STREAM_PROVIDER=upstox
STOCKPILOT_UPSTOX_PROTO_MODULE=
STOCKPILOT_STREAM_STALE_AFTER_SECONDS=5.0

# Annually-refreshable NSE holiday calendar (item 12). Leave unset to rely on
# the bundled 2026 calendar; set both to adopt next year's circular via
# POST /api/v1/market/calendar/refresh/{year}.
STOCKPILOT_NSE_CALENDAR_URL=
STOCKPILOT_NSE_CALENDAR_CACHE_PATH=

# Licensed vendor gateways must expose StockPilot's normalized /quote and
# /history JSON contract. Vendor credentials stay inside the deployment-owned
# gateway and are never sent to the browser.
TRUEDATA_GATEWAY_URL=
TRUEDATA_GATEWAY_TOKEN=
GLOBALDATAFEEDS_GATEWAY_URL=
GLOBALDATAFEEDS_GATEWAY_TOKEN=

# Workers / cache
STOCKPILOT_REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
# Optional multi-process broker stream leadership. When enabled, one API
# worker owns each upstream symbol lease and followers receive normalized
# ticks over Redis pub/sub. Leave false for single-process/local demos.
STOCKPILOT_REDIS_STREAM_LEADERSHIP=false
STOCKPILOT_STREAM_LEASE_SECONDS=6
STOCKPILOT_ENABLE_SCHEDULER=false
# The bounded retention scheduler runs independently of provider/retraining jobs.
STOCKPILOT_RETENTION_ENABLED=true
STOCKPILOT_RETENTION_HOUR=2
STOCKPILOT_RETENTION_MINUTE=15
STOCKPILOT_AUDIT_RETENTION_DAYS=365
STOCKPILOT_ADMIN_AUDIT_RETENTION_DAYS=730
STOCKPILOT_SECURITY_ARTIFACT_RETENTION_DAYS=7
STOCKPILOT_FORECAST_ARTIFACT_RETENTION_DAYS=30
STOCKPILOT_RETENTION_BATCH_SIZE=1000
STOCKPILOT_RETRAIN_SYMBOLS=RELIANCE,TCS,INFY,HDFCBANK
STOCKPILOT_SCHEDULER_TIMEZONE=Asia/Kolkata
STOCKPILOT_RETRAIN_HOUR=18
STOCKPILOT_RETRAIN_MINUTE=30

# API security / observability
STOCKPILOT_RATE_LIMIT_REQUESTS=240
STOCKPILOT_RATE_LIMIT_WINDOW_SECONDS=60
STOCKPILOT_REGISTER_RATE_LIMIT=5
STOCKPILOT_LOGIN_RATE_LIMIT=10
STOCKPILOT_PASSWORD_RESET_RATE_LIMIT=5
STOCKPILOT_FORECAST_RATE_LIMIT=30
STOCKPILOT_FORECAST_STATUS_RATE_LIMIT=120
# Enable only behind a correctly configured trusted reverse proxy.
STOCKPILOT_TRUST_PROXY=false
STOCKPILOT_LOG_LEVEL=INFO
STOCKPILOT_LOG_MAX_BYTES=2000000
STOCKPILOT_LOG_BACKUPS=5
SENTRY_DSN=

# Optional auth/recovery integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/v1/auth/google/callback
# Apple requires an HTTPS Services ID callback for real verification. A local
# value is useful only for fixture tests; never package the private key.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=https://your-approved-host.example/api/v1/auth/apple/callback
APP_BASE_URL=http://127.0.0.1:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=StockPilot AI <noreply@example.com>
SMTP_USE_TLS=true

# Optional licensed/approved RSS or Atom connector. The URL may contain
# {symbol}; attribution is shown exactly as configured. Leave blank rather than
# serving unlicensed or fabricated headlines.
STOCKPILOT_NEWS_RSS_URL=
STOCKPILOT_NEWS_PUBLISHER=
STOCKPILOT_NEWS_CACHE_SECONDS=300
STOCKPILOT_ALERT_COOLDOWN_SECONDS=900
STOCKPILOT_ALERT_EVALUATION_INTERVAL_MINUTES=5

# Optional grounding-only research assistant (K5). Leave all three blank to
# ship in refusal mode: the application then answers "provider not configured"
# and returns only its fully sourced fact table. When set, the OpenAI-compatible
# /chat/completions endpoint is called with temperature 0 and every numeric
# figure in the answer must be traced back to the ingested fact table or the
# answer is refused. The key is read server-side and never returned.
STOCKPILOT_LLM_BASE_URL=
STOCKPILOT_LLM_API_KEY=
STOCKPILOT_LLM_MODEL=

# SQLite is permanent and default. URLs alone NEVER select PostgreSQL.
# PostgreSQL runtime adoption is still incomplete; see DEPLOYMENT.md before selecting it.
DB_BACKEND=sqlite
# Backend-only: pooled application URL and direct (non-pooler) migration URL.
# Store actual values with scripts/manage_secrets.py, not in frontend/public variables.
DATABASE_URL=
DATABASE_MIGRATION_URL=

# --- Read by the code but previously undocumented (v8 audit) ---------------
# Every key below is optional: unset means the compiled-in default applies.
# Listed so an operator can see every switch the code actually reads.
# Minimum seconds between calls, per provider adapter
# STOCKPILOT_GLOBALDATAFEEDS_MIN_INTERVAL_SECONDS=
# STOCKPILOT_NSE_MIN_INTERVAL_SECONDS=
# STOCKPILOT_TRUEDATA_MIN_INTERVAL_SECONDS=
# STOCKPILOT_UPSTOX_MIN_INTERVAL_SECONDS=
# STOCKPILOT_YFINANCE_MIN_INTERVAL_SECONDS=
# Headline sentiment backend
# STOCKPILOT_SENTIMENT_BACKEND=
# STOCKPILOT_FINBERT_MODEL=
# Scheduled retraining job parameters
# STOCKPILOT_RETRAIN_TIMEFRAME=
# STOCKPILOT_RETRAIN_WINDOW=
# STOCKPILOT_RETRAIN_CONFIDENCE=
# Paper-trade settlement sweep cadence
# STOCKPILOT_SETTLEMENT_INTERVAL_MINUTES=
# STOCKPILOT_SETTLEMENT_GRACE_SECONDS=
# Diagnostics, readiness probes, release gating
# STOCKPILOT_READINESS_SYMBOL=
# STOCKPILOT_LIVE_TEST_SYMBOL=
# STOCKPILOT_RELEASE_CHECK=
# STOCKPILOT_STRICT_RUNTIME=
# STOCKPILOT_MARKET_MEMORY_CACHE_MAX_ENTRIES=
