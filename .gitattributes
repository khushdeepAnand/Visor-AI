# Normalize line endings in the repository; check out native on each platform.
* text=auto

# Windows-only launchers must keep CRLF or cmd.exe mis-parses them.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Always LF — these run in Linux containers/CI.
*.sh text eol=lf
Dockerfile* text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary / generated: never diff or normalize.
*.pkl binary
*.db binary
*.joblib binary
*.png binary
*.jpg binary
*.pyd binary
package-lock.json -diff linguist-generated
